{
  "manifest_version": 3,
  "name": "LotKeys Facebook Assistant",
  "version": "0.1.14",
  "version_name": "0.1.14 Beta",
  "description": "Beta companion for faster, reliable Facebook Marketplace vehicle listing fill from LotKeys.",
  "homepage_url": "https://github.com/MrMilo34/Lot-Keys/tree/main/extension",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://mrmilo34.github.io/Lot-Keys/*",
    "https://mrmilo34.github.io/Lot-Keys-TEST/*",
    "https://lot-keys.ca/*",
    "https://www.lot-keys.ca/*",
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://raw.githubusercontent.com/MrMilo34/Lot-Keys/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open LotKeys Facebook Assistant",
    "default_icon": "icon.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": [
        "facebook.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel.html",
        "sidepanel.css",
        "sidepanel.js",
        "icon.png"
      ],
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*"
      ]
    }
  ]
}
